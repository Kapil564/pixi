# Windows Assistant — environment variables
# =====================================================================
# You do NOT need to fill everything in. Only fill the section for each
# provider you actually have. Anything left blank falls back to a free or
# local alternative automatically.
#
# Quick-start presets:
#   - No keys at all        → Local Piper TTS, local Ollama LLM, local Whisper STT
#   - OpenAI key            → OpenAI Whisper STT + GPT-4o-mini intent + Local Piper TTS
#   - ElevenLabs key        → Premium voice TTS (STT/LLM fall back as above)
#   - Gemini key            → Gemini Flash intent (STT/TTS fall back as above)
#   - Groq key              → Fast Groq Whisper STT + Groq Llama intent + Local Piper TTS
#   - Privacy mode          → Leave all API keys blank, run Ollama + Whisper + Piper locally
# =====================================================================

PORT=16123

# === Speech-to-Text (STT) & LLM API Keys ===
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# === Text-to-Speech (TTS) API Keys ===
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s2.1-pro-free

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=C8uRRxxNZH0vRqJbVFJy

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# === Cloudflare Workers AI & AI Gateway (Optional) ===
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_GATEWAY_ID=
CLOUDFLARE_STT_MODEL=@cf/openai/whisper
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TTS_MODEL=elevenlabs/eleven-multilingual-v2

# === Memory & Context ===
MEM0_API_KEY=

# === Provider selection overrides (optional) ===
# Normally the app auto-selects based on which keys are present.
# Set these only if you want to force a specific provider.
# LLM_PROVIDER=openai|gemini|groq|ollama|cloudflare
# STT_PROVIDER=openai|groq|cloudflare|elevenlabs|whisper
# TTS_PROVIDER=piper|fishaudio|elevenlabs|azure|cloudflare

# === Local / offline services ===
# Ollama is used automatically when no LLM API key is set.
OLLAMA_BASE_URL=http://localhost:11434

# ===================================================================
# After editing this file, rename it to .env
# ===================================================================
