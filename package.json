{
  "name": "saira-assistant",
  "version": "0.1.0",
  "description": "A Siri-like Windows voice assistant with pluggable STT/LLM/TTS providers",
  "main": "dist/main/index.js",
  "author": "Kapil564",
  "license": "MIT",
  "scripts": {
    "dev:css": "tailwindcss -i ./src/renderer/styles.css -o ./dist/renderer/styles.css --watch",
    "dev:js": "tsup --watch --onSuccess \"electronmon .\"",
    "dev": "concurrently -k -p \"[{name}]\" -n \"CSS,JS\" -c \"blue.bold,green.bold\" \"pnpm dev:css\" \"pnpm dev:js\"",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', { recursive: true, force: true });\"",
    "build:css": "tailwindcss -i ./src/renderer/styles.css -o ./dist/renderer/styles.css --minify",
    "build": "pnpm clean && tsup && pnpm build:css",
    "start": "electronmon .",
    "postinstall": "electron-rebuild",
    "prepack": "electron-rebuild && pnpm build",
    "pack": "electron-builder",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "rebuild": "electron-rebuild"
  },
  "electronmon": {
    "patterns": [
      "!*.log",
      "!*.txt",
      "!log.txt",
      "!*.wav",
      "!*.tmp",
      "!assistant.db*",
      "!.env*"
    ]
  },
  "dependencies": {
    "@google/generative-ai": "^0.16.0",
    "better-sqlite3": "^11.0.0",
    "bindings": "^1.5.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "file-uri-to-path": "^2.0.0",
    "fish-audio": "^0.1.0",
    "groq-sdk": "^0.5.0",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^4.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.22.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.0",
    "electronmon": "^2.0.4",
    "node-gyp": "^13.0.1",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
